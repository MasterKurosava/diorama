{
  "name": "@dioramajs/assets",
  "version": "0.1.1",
  "description": "Asset loading for Diorama: cache, preload and progress; glTF with Draco, Meshopt and KTX2.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "loader",
    "gltf",
    "ktx2"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/assets"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./three": {
      "@dioramajs/source": "./src/three/index.ts",
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/core": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "@dioramajs/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dioramajs/core": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/node": "26.6.6",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
