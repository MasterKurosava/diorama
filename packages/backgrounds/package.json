{
  "name": "@dioramajs/backgrounds",
  "version": "0.1.2",
  "description": "Shader backgrounds for Diorama: gradient, blobs, clouds, stars, grid, waves and dots.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "background",
    "gradient"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/backgrounds"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gradient": {
      "@dioramajs/source": "./src/gradient.ts",
      "types": "./dist/gradient.d.ts",
      "default": "./dist/gradient.js"
    },
    "./dots": {
      "@dioramajs/source": "./src/dots.ts",
      "types": "./dist/dots.d.ts",
      "default": "./dist/dots.js"
    },
    "./waves": {
      "@dioramajs/source": "./src/waves.ts",
      "types": "./dist/waves.d.ts",
      "default": "./dist/waves.js"
    },
    "./stars": {
      "@dioramajs/source": "./src/stars.ts",
      "types": "./dist/stars.d.ts",
      "default": "./dist/stars.js"
    },
    "./blobs": {
      "@dioramajs/source": "./src/blobs.ts",
      "types": "./dist/blobs.d.ts",
      "default": "./dist/blobs.js"
    },
    "./clouds": {
      "@dioramajs/source": "./src/clouds.ts",
      "types": "./dist/clouds.d.ts",
      "default": "./dist/clouds.js"
    },
    "./grid": {
      "@dioramajs/source": "./src/grid.ts",
      "types": "./dist/grid.d.ts",
      "default": "./dist/grid.js"
    },
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "meta.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/effects": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/effects": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
