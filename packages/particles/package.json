{
  "name": "@dioramajs/particles",
  "version": "0.1.0",
  "description": "Particle effects for Diorama: confetti, snow, sparkles, drops and emoji.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "particles",
    "confetti"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/particles"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./confetti": {
      "@dioramajs/source": "./src/confetti.ts",
      "types": "./dist/confetti.d.ts",
      "default": "./dist/confetti.js"
    },
    "./sparkles": {
      "@dioramajs/source": "./src/sparkles.ts",
      "types": "./dist/sparkles.d.ts",
      "default": "./dist/sparkles.js"
    },
    "./snow": {
      "@dioramajs/source": "./src/snow.ts",
      "types": "./dist/snow.d.ts",
      "default": "./dist/snow.js"
    },
    "./emoji": {
      "@dioramajs/source": "./src/emoji.ts",
      "types": "./dist/emoji.d.ts",
      "default": "./dist/emoji.js"
    },
    "./drops": {
      "@dioramajs/source": "./src/drops.ts",
      "types": "./dist/drops.d.ts",
      "default": "./dist/drops.js"
    },
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "meta.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/effects": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/effects": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
