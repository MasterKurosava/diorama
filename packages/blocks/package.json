{
  "name": "@dioramajs/blocks",
  "version": "0.1.1",
  "description": "Effects for cards and buttons in Diorama: beam, glow and shine.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "card",
    "button"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/blocks"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./beam": {
      "@dioramajs/source": "./src/beam.ts",
      "types": "./dist/beam.d.ts",
      "default": "./dist/beam.js"
    },
    "./glow": {
      "@dioramajs/source": "./src/glow.ts",
      "types": "./dist/glow.d.ts",
      "default": "./dist/glow.js"
    },
    "./shine": {
      "@dioramajs/source": "./src/shine.ts",
      "types": "./dist/shine.d.ts",
      "default": "./dist/shine.js"
    },
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "meta.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/core": "workspace:^",
    "@dioramajs/effects": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/core": "workspace:*",
    "@dioramajs/effects": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
