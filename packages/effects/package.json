{
  "name": "@dioramajs/effects",
  "version": "0.1.1",
  "description": "Effects on DOM elements for Diorama: effect(), the runtime and the kit of helpers.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "shader"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/effects"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "@dioramajs/source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./effect": {
      "@dioramajs/source": "./src/effect.ts",
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./kit": {
      "@dioramajs/source": "./src/kit.ts",
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./testing": {
      "@dioramajs/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/core": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/core": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
