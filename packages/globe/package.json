{
  "name": "@dioramajs/globe",
  "version": "0.1.1",
  "description": "Interactive globe with markers and arcs for Diorama.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "globe",
    "map"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/globe"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./globe": {
      "@dioramajs/source": "./src/globe.ts",
      "types": "./dist/globe.d.ts",
      "default": "./dist/globe.js"
    },
    "./land": {
      "@dioramajs/source": "./src/land.ts",
      "types": "./dist/land.d.ts",
      "default": "./dist/land.js"
    },
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "meta.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/effects": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/effects": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
