{
  "name": "@dioramajs/audio",
  "version": "0.1.3",
  "description": "Audio-reactive effects for Diorama: visualizer and beat.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "audio",
    "visualizer"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/audio"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./beat": {
      "@dioramajs/source": "./src/beat.ts",
      "types": "./dist/beat.d.ts",
      "default": "./dist/beat.js"
    },
    "./visualizer": {
      "@dioramajs/source": "./src/visualizer.ts",
      "types": "./dist/visualizer.d.ts",
      "default": "./dist/visualizer.js"
    },
    "./graph": {
      "@dioramajs/source": "./src/graph.ts",
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "meta.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/effects": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/effects": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
