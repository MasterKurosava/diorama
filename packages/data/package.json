{
  "name": "@dioramajs/data",
  "version": "0.1.1",
  "description": "Charts, graphs, heatmaps and maps for Diorama.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "chart",
    "map",
    "data-visualization"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/data"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chart": {
      "@dioramajs/source": "./src/chart.ts",
      "types": "./dist/chart.d.ts",
      "default": "./dist/chart.js"
    },
    "./graph": {
      "@dioramajs/source": "./src/graph.ts",
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./heatmap": {
      "@dioramajs/source": "./src/heatmap.ts",
      "types": "./dist/heatmap.d.ts",
      "default": "./dist/heatmap.js"
    },
    "./map": {
      "@dioramajs/source": "./src/map.ts",
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./meta.json": "./meta.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "meta.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/core": "workspace:^",
    "@dioramajs/effects": "workspace:^",
    "@dioramajs/globe": "workspace:^",
    "@dioramajs/render": "workspace:^",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@dioramajs/core": "workspace:*",
    "@dioramajs/effects": "workspace:*",
    "@dioramajs/globe": "workspace:*",
    "@dioramajs/render": "workspace:*",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
