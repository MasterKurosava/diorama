{
  "name": "@diorama/glsl",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@diorama/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entries": {
      "@diorama/source": "./src/entries.ts",
      "types": "./dist/entries.d.ts",
      "default": "./dist/entries.js"
    },
    "./convert": {
      "@diorama/source": "./src/convert/index.ts",
      "types": "./dist/convert.d.ts",
      "default": "./dist/convert.js"
    },
    "./vite": {
      "@diorama/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./loader": {
      "@diorama/source": "./src/loader.ts",
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "diorama-glsl": "./bin/diorama-glsl.mjs"
  },
  "files": [
    "bin",
    "client.d.ts",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@diorama/core": "workspace:^",
    "@diorama/effects": "workspace:^",
    "three": "^0.187.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@diorama/core": "workspace:*",
    "@diorama/effects": "workspace:*",
    "@types/node": "26.6.6",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  }
}
