{
  "name": "@dioramajs/glsl",
  "version": "0.1.0",
  "description": "GLSL to three.js TSL converter: Vite plugin, webpack loader and CLI.",
  "keywords": [
    "diorama",
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "tsl",
    "glsl",
    "shadertoy",
    "vite-plugin"
  ],
  "homepage": "https://dioramajs.dev",
  "bugs": "https://github.com/MasterKurosava/diorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterKurosava/diorama.git",
    "directory": "packages/glsl"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@dioramajs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entries": {
      "@dioramajs/source": "./src/entries.ts",
      "types": "./dist/entries.d.ts",
      "default": "./dist/entries.js"
    },
    "./convert": {
      "@dioramajs/source": "./src/convert/index.ts",
      "types": "./dist/convert.d.ts",
      "default": "./dist/convert.js"
    },
    "./vite": {
      "@dioramajs/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./loader": {
      "@dioramajs/source": "./src/loader.ts",
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dioramajs-glsl": "./bin/diorama-glsl.mjs"
  },
  "files": [
    "bin",
    "client.d.ts",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@dioramajs/core": "workspace:^",
    "@dioramajs/effects": "workspace:^",
    "three": "^0.187.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dioramajs/core": "workspace:*",
    "@dioramajs/effects": "workspace:*",
    "@types/node": "26.6.6",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
